; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="箭头出逃"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

MiniGameSDK="*res://addons/godot_mini_game/MiniGameSDK.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/size/window_width_override.web=0
window/size/window_height_override.web=0

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mini_game/plugin.cfg")

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]

environment/defaults/default_clear_color=Color(0.949, 0.957, 0.937, 1)
